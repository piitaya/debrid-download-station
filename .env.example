# Copy to .env for `npm run dev` (API on :8080, web app on http://localhost:5173).
# The addresses of AllDebrid, Real-Debrid and TorBox are built in: only the NAS is needed.
SYNOLOGY_URL=http://192.168.1.10:5000
# DSM over HTTPS with its self-signed certificate:
# SYNOLOGY_INSECURE_TLS=true
# Optional, the key can also be entered in the Settings page:
# ALLDEBRID_API_KEY=
DATA_DIR=./data
LOG_LEVEL=debug

# Without a NAS: `npm run dev:mock` runs a fake NAS and fake debrid services on :5055 (log in
# with admin / admin). Use these lines instead of SYNOLOGY_URL and ALLDEBRID_API_KEY above:
# SYNOLOGY_URL=http://localhost:5055
# ALLDEBRID_API_URL=http://localhost:5055/alldebrid
# REALDEBRID_API_URL=http://localhost:5055/realdebrid
# TORBOX_API_URL=http://localhost:5055/torbox
# ALLDEBRID_API_KEY=mock
