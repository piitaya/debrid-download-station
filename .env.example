# Local development. With `npm run dev:mock`, a fake NAS and fake debrid services run on :5055
# (log in with admin / admin).
SYNOLOGY_URL=http://localhost:5055
ALLDEBRID_API_URL=http://localhost:5055/alldebrid
REALDEBRID_API_URL=http://localhost:5055/realdebrid
TORBOX_API_URL=http://localhost:5055/torbox
ALLDEBRID_API_KEY=mock
DATA_DIR=./data
LOG_LEVEL=debug

# Real NAS:
# SYNOLOGY_URL=http://192.168.1.10:5000
# SYNOLOGY_INSECURE_TLS=true
